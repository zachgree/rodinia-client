// Shared build settings. Personal values (team, bundle prefix) live in
// Local.xcconfig, which is git-ignored; copy Local.xcconfig.example to start.

BUNDLE_PREFIX = com.example.rodinia
DEVELOPMENT_TEAM =

MACOSX_DEPLOYMENT_TARGET = 15.0
SWIFT_VERSION = 6.0
MARKETING_VERSION = 0.1.1
CURRENT_PROJECT_VERSION = 3

CODE_SIGN_STYLE = Automatic
ENABLE_HARDENED_RUNTIME = YES
DEAD_CODE_STRIPPING = YES

// Xcode signs for development. Development profiles only allow this plain value;
// scripts/release.sh re-signs with Developer ID and the -systemextension value.
NE_TUNNEL_PROVIDER = packet-tunnel-provider

APP_BUNDLE_ID = $(BUNDLE_PREFIX).client
TUNNEL_BUNDLE_ID = $(APP_BUNDLE_ID).tunnel

// Sparkle updates. The feed is an asset of the latest GitHub release, written by
// scripts/release.sh and signed with the EdDSA key whose public half is below.
// A fork that ships its own builds sets both in Local.xcconfig.
// ("$()" keeps xcconfig from reading the "//" as a comment.)
UPDATE_FEED_URL = https:/$()/github.com/zachgree/rodinia-client/releases/latest/download/appcast.xml
UPDATE_PUBLIC_KEY = AUXPNpzKLtiz1fO76ek8aOlJtzy64reHc7XUH56Tt90=

#include? "Local.xcconfig"
